    {
      "id": "claim_f66faafacb124b6f8c0d63b8c72ed337",
      "statement": "The system_prompt mandates a three-phase research protocol: EXPLORATORY (search_regions, calculate_rti_score, calculate_crisis_comparison; prioritize Learning Delta when significant), DIAGNOSTIC (calculate_recovery_speed, calculate_structural_shift, and calculate_vulnerability_index when values exceed +/-15), and SYNTHESIS (analyze_socioeconomic_coupling and calculate_rtix_score for both economic and social). It requires Greek region names, never asking for clarification, and archiving the verdict with save_finding.",
      "evidence": [
        {
          "resource": "repo://agent.py#L410-L438",
          "version": "repo-lines-v1:sha256:29b9171ea2ba83987528a4a185d234a98f52aba088423eb5015c8fd22d5cb9c6:"
        }
      ]
    },
