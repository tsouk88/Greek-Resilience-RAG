    {
      "id": "claim_5d4fe149359c4c7f821a0d1f1cf4fcc3",
      "statement": "The only remaining GitHub Actions workflow is .github/workflows/openwiki-update.yml, named OpenWiki Update; it runs on workflow_dispatch and a monthly schedule (cron 0 6 1 * *), uses actions/checkout@v4 with fetch-depth 0 and the OPENWIKI_PAT secret, installs OpenWiki globally on Node.js 22, runs openwiki code --update --print with OPENWIKI_PROVIDER=openrouter and OPENWIKI_MODEL_ID=z-ai/glm-5.2, and opens a PR via peter-evans/create-pull-request@v7 on the openwiki/update branch.",
