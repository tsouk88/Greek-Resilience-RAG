    {
      "id": "claim_cfdd6a711ccf43d188c815e32719072b",
      "statement": "Google Gemini is the sole external LLM and is used in two modes: main.py constructs ChatGoogleGenerativeAI(model=\"gemini-2.5-flash\") for the /ask RAG path, while agent.py constructs ChatGoogleGenerativeAI(model=\"gemini-2.5-pro\") for the tool-driven research agent; both read the API key from the GEMMA_API_KEY environment variable.",
      "evidence": [
        {
          "resource": "repo://agent.py#L16-L16",
