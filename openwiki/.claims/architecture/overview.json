    {
      "id": "claim_c1e420c4f64f42b2a6b9b2819eb18c28",
      "statement": "rag.py is the offline indexing script: it reads the workbook from FILE_PATH (default data/stats.xlsx), iterates six Greek sheet labels through loader.load_excel_data, and persists all chunks to ./chroma_db via Chroma.from_documents(documents=all_docs, persist_directory='./chroma_db').",
      "evidence": [
        {
          "resource": "repo://rag.py#L6-L25",
          "version": "repo-lines-v1:sha256:e687524c503f081d385de856cae8a51e00b8f617d8c95123129877173fc2d6d2:"
        }
      ]
    },
    {
      "id": "claim_01b921ef592e44d5897f620918ec0d78",
      "statement": "loader.load_excel_data converts one workbook sheet into langchain_core.documents.Document objects, normalizing headers, skipping the national row (Ελλάδα), and emitting one document per region × indicator × era with region/indicator/era/source metadata that pairs regional values with national values.",
      "evidence": [
        {
          "resource": "repo://loader.py#L7-L62",
          "version": "repo-lines-v1:sha256:d7caeb0941076209b38387edd656eaf887f1bc5fc8367cd510edb11781ffab35:"
        }
      ]
    },
    {
      "id": "claim_d698f0ed5fcc45859b20c0034c221dfa",
      "statement": "The Excel workbook is the source of truth and ChromaDB is a local rebuilt artifact: at startup main.py loads the existing index with Chroma(persist_directory='./chroma_db'), and if the workbook changes python rag.py must be rerun because there is no runtime embedding step.",
      "evidence": [
