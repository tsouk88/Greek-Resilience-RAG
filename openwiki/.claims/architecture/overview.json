    {
      "id": "claim_0552b6109cf542789aa463c5c809f9d3",
      "statement": "POST /agent invokes the LangChain agent with {'messages': [{'role':'user','content': question}]} and config {'configurable': {'thread_id': 'research-session-3'}}, then returns the last message content as the answer (unwrapping a list content into text[0]).",
      "evidence": [
