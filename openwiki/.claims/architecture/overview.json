  "claims": [
    {
      "id": "claim_d9ef3571f10c41f288a874aba7d2bb6f",
      "statement": "The backend is a single-process FastAPI application backed by a local ChromaDB vector store and an Excel workbook, exposing two user-facing API paths: POST /ask for retrieval-augmented answers and POST /agent for tool-driven agent analysis.",
      "evidence": [
        {
          "resource": "repo://agent.py",
          "version": "repo-file-v1:sha256:999eebb3b0986752025b5eed97bd5605b0a18e7ff24e787f20a7af231ce775d5"
        },
        {
          "resource": "repo://main.py",
          "version": "repo-file-v1:sha256:e54877ec03d0818d2c0cec5b252cb15e4bca325b836c4412a8c84034b2ae3ace"
        }
      ]
    },
    {
      "id": "claim_d928e62756ed439c8303f4948839a8d8",
      "statement": "POST /ask reads ChromaDB and answers with gemini-2.5-flash, whereas POST /agent runs a LangChain/LangGraph agent backed by gemini-2.5-pro; the central distinction is that /ask reads the prebuilt ChromaDB index while /agent tools mostly read the Excel workbook directly with pandas.",
