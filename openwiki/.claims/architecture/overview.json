    {
      "id": "claim_6ef32166059a442fa03e39f7f9520fed",
      "statement": "POST /ask performs vectorstore.similarity_search with k=10, then enriches the result set by running an additional filtered similarity_search(k=5, filter={'region': region}) for each of 13 hardcoded Greek regions where thefuzz.fuzz.partial_ratio exceeds 80 and the region is not already present, then feeds the combined context to the Gemini Flash chain.",
      "evidence": [
        {
          "resource": "repo://main.py#L29-L54",
          "version": "repo-lines-v1:sha256:f278a8343c0706ea29854fcf9ecba840742da03b349e38e4b4aedf7e104e3a2d:"
        }
